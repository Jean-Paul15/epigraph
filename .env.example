# Copier ce fichier vers .env puis remplacer les valeurs factices.
# Le fichier .env ne doit jamais être versionné.

# Neo4j (le mot de passe doit contenir au moins 8 caractères)
NEO4J_USER=neo4j
NEO4J_PASSWORD=changez_moi_mot_de_passe

# Jupyter
JUPYTER_TOKEN=changez_moi_jeton

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
